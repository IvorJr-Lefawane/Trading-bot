# Copy this file to `.env` to change settings without editing code.
# `.env` is git-ignored. Loaded automatically by the npm scripts (Node 20.12+).
#
# ---------------------------------------------------------------------------
# GENERIC API KEY NAMES: NEVER SET THESE
# ---------------------------------------------------------------------------
# If ANY of these are set, the bot refuses to start — in EVERY mode, live
# included. That is deliberate: a key pasted into the obvious name by reflex
# cannot start anything. Each mode reads its own distinct names below.
#
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# API_KEY=
# API_SECRET=

# ---------------------------------------------------------------------------
# TESTNET CREDENTIALS (fake money)
# ---------------------------------------------------------------------------
# Get them free at https://testnet.binance.vision — sign in with GitHub and
# generate a HMAC key pair. Testnet accounts come pre-funded with fake balances.
# These keys work ONLY on the testnet; they are useless against a real account.
#
# NEVER paste these into a chat. Nothing needs to see them but this file.
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=

# ---------------------------------------------------------------------------
# TRADING MODE
# ---------------------------------------------------------------------------
# "paper"   — everything simulated locally (default)
# "testnet" — real authenticated orders against Binance Spot Testnet (fake money)
# "live"    — REAL MONEY on your Binance account (see LIVE TRADING below)
#
# "real" and "mainnet" are refused. Live mode is spelled "live" and also needs
# the acknowledgement, live keys and a state file before it will start.
TRADING_MODE=paper

# How long a signed request stays valid, in ms. Raise it if you see
# "Timestamp for this request is outside of the recvWindow" on a slow connection.
RECV_WINDOW_MS=5000

# ---------------------------------------------------------------------------
# LIVE TRADING (REAL MONEY) — leave all of this commented out unless you mean it
# ---------------------------------------------------------------------------
# Create the key at Binance > Account > API Management with spot trading ON,
# withdrawals OFF and transfers OFF (the bot refuses keys that can withdraw),
# and restrict it to this machine's IP.
# BINANCE_LIVE_API_KEY=
# BINANCE_LIVE_API_SECRET=
#
# Must be exactly this phrase. Best typed in the shell per session rather than
# saved here, so live mode never starts from a file someone forgot about.
# LIVE_TRADING_ACKNOWLEDGED=i-understand-real-money
#
# Per-order cap in quote currency (USDT). Hard ceiling of 250 is in the source.
# MAX_ORDER_NOTIONAL=25
#
# Before the first live run: npm run live:check, then npm run state:init.
# Kill switch: create the file data/HALT.

# ---------------------------------------------------------------------------
# STRATEGY (optional overrides)
# ---------------------------------------------------------------------------
# trend_following (default) | donchian_breakout | rsi_mean_reversion | ma_crossover
# STRATEGY=trend_following
# INTERVAL=1d
# TREND_LOOKBACK=100
# SYMBOL=BTCUSDT

# ---------------------------------------------------------------------------
# LIVE LOOP (testnet)
# ---------------------------------------------------------------------------
LIVE_INTERVAL_SECONDS=300
LIVE_MAX_CYCLES=0

# Round-trip test order: seconds held before selling back, and how far above the
# exchange minimum to size it.
TESTORDER_HOLD_SECONDS=5
TESTORDER_SIZE_MULT=1.5

# ---------------------------------------------------------------------------
# TRADING COSTS — the numbers that decide whether a strategy is real
# ---------------------------------------------------------------------------
# Binance spot standard fee is 0.10% per side (0.075% if you pay fees in BNB).
# A round trip therefore costs 2 x (fee + slippage). Any strategy must clear
# that per trade before it earns you a single cent. Do not lower these to make
# a backtest look better — you'll just be lying to yourself with extra steps.
FEE_PCT_PER_SIDE=0.001
SLIPPAGE_PCT_PER_SIDE=0.0001

# ---------------------------------------------------------------------------
# MULTI-WINDOW TESTING
# ---------------------------------------------------------------------------
# How many separate historical windows `replay:windows` tests, and how big each is.
WINDOW_COUNT=6
WINDOW_CANDLES=2000

# ---------------------------------------------------------------------------
# BACKTEST TUNING (optional)
# ---------------------------------------------------------------------------
# How many historical candles `replay:raw` pulls (2000 ≈ 1 week of 5m candles).
REPLAY_CANDLES=2000

# How many candles forward each simulated trade runs before timing out (12 ≈ 1 hour).
REPLAY_FORWARD=12

# How far back `replay:memory` looks for the most recent entry candidate.
REPLAY_MEMORY_LOOKBACK=500
